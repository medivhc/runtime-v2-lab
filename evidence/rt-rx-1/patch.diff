+    # Verify output
+    if [[ ! -f "$output" ]]; then
+        echo "FAIL: Output file not created"
+        return 1
+    fi
+    
+    local content
+    content=$(cat "$output")
+    echo "Output content:"
+    echo "$content"
+    echo "---"
+    
