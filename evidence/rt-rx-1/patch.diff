+    if ! grep -q "处方草稿，须人工确认后应用，脚本不自动修改任何流程文件" "$output"; then
+        echo "FAIL: Missing header disclaimer"
+        return 1
+    fi
+    
+    # Check action is valid (should be append_review_prompt as default)
+    local action
