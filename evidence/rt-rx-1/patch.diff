+    if ! grep -q "处方草稿，须人工确认后应用，脚本不自动修改任何流程文件" "$output"; then
+        echo "FAIL: Missing header disclaimer"
+        return 1
+    fi
+    
+    # Check outputs "无处方建议"
+    if ! grep -q "无处方建议" "$output"; then
